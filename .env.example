# Django core
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False

# PythonAnywhere specific hosts
ALLOWED_HOSTS=rkarra.pythonanywhere.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://rkarra.pythonanywhere.com

# Database - Use PostgreSQL on production
# Example:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# Leave empty to use SQLite locally
DATABASE_URL=

# Database connection settings
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=False
DB_SSLMODE=require

# Auto-publish settings
AUTO_PUBLISH_USER_NEWS=False

# OTP provider configuration
# Options: console, twilio, msg91
OTP_PROVIDER=console
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM_NUMBER=
OTP_MSG91_AUTH_KEY=
OTP_MSG91_SENDER_ID=JBACOT
OTP_MSG91_TEMPLATE_ID=
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15

# Andhra Christian Songs API
ANDHRA_CHRISTIAN_SONGS_API_URL=
ANDHRA_CHRISTIAN_SONGS_API_KEY=
ANDHRA_CHRISTIAN_SONGS_BOOKS_URL=https://raw.githubusercontent.com/WeCareLtd/SingUntoLord_DB/main/availableBooks.json
ANDHRA_CHRISTIAN_SONGS_TIMEOUT_SECONDS=10

# Christian Books API
CHRISTIAN_BOOKS_API_URL=https://gutendex.com/books
CHRISTIAN_BOOKS_DEFAULT_QUERY=christianity
CHRISTIAN_BOOKS_MAX_RESULTS=36
